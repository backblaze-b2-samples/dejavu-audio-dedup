# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_BUCKET_NAME=my-audio-catalog
# B2_REGION is the two-letter region + number from your bucket's S3 endpoint,
# e.g. an endpoint of s3.us-west-004.backblazeb2.com => B2_REGION=us-west-004

# Optional: public base URL for a public bucket (builds unsigned object URLs).
# The app runs without it — presigned URLs are used for playback either way.
# B2_PUBLIC_URL_BASE=https://my-audio-catalog.s3.us-west-004.backblazeb2.com

# The S3 endpoint is derived from B2_REGION as
# https://s3.<B2_REGION>.backblazeb2.com — no separate endpoint variable.

# MySQL fingerprint database (Dejavu's canonical backend) — non-B2 infra.
# Matches infra/docker-compose.yml. Start it with:
#   docker compose -f infra/docker-compose.yml up -d mysql
FP_DB_HOST=127.0.0.1
FP_DB_PORT=3306
FP_DB_USER=dejavu
FP_DB_PASSWORD=dejavu
FP_DB_NAME=dejavu

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
